# UTF-8, LF, and spaces.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

# Two trailing spaces are a Markdown hard break.
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# PSR-12 requires four spaces. Other files in this project do not set an indent size.
# https://www.php-fig.org/psr/psr-12/
[*.php]
indent_size = 4
